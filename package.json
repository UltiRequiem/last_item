{
  "name": "@ultirequiem/last-item",
  "version": "0.0.0-development",
  "description": "Get the last item of an array.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib/**/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "item",
    "array"
  ],
  "license": "MIT",
  "homepage": "https://ulti.js.org/last_item",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UltiRequiem/last_item.git"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint 'src/**/*.ts' && prettier --check 'src/**/*.ts'",
    "fmt": "prettier --write 'src/**/*.ts'",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "eslint-plugin-unicorn": "^78.0.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.6.0"
}
